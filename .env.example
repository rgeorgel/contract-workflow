# Modelo para o servidor (testes e produção): cp .env.example .env NO SERVIDOR e preencha.
# Para desenvolvimento local, use o .env.example.local.
# Lê só o docker-compose.yml: o override (Postgres local, Mailpit, portas de debug) fica de fora.
COMPOSE_FILE=docker-compose.yml

# App
ASPNETCORE_ENVIRONMENT=Staging
APP_PORT=7700
# URL pública, usada nos links dos e-mails. Precisa ser HTTPS: fora de Development os cookies são Secure.
PUBLIC_BASE_URL=https://contratos-teste.exemplo.com.br
# A app fica atrás de um proxy com TLS (Caddy, Nginx, load balancer)
FORWARDED_HEADERS=true
# Aplica as migrations na subida (prático em testes; em produção prefira o bundle antes do deploy)
MIGRATE_ON_STARTUP=true

# Banco externo
DB_HOST=
DB_PORT=5432
DB_NAME=contratos
DB_USER=contratos
DB_PASSWORD=
DB_SSL_MODE=require

# Storage S3. Com o serviço "s3" do compose (SeaweedFS) deixe como está; para um S3 externo, troque a URL e as chaves.
S3_SERVICE_URL=http://s3:8333
S3_BUCKET=contratos
S3_ACCESS_KEY=
S3_SECRET_KEY=

# E-mails do sistema (confirmação de cadastro, convites, nova senha)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@exemplo.com.br

# Assinatura: Fake até a fase 4
SIGNATURE_PROVIDER=Fake
AUTENTIQUE_API_KEY=
AUTENTIQUE_WEBHOOK_SECRET=
AUTENTIQUE_SANDBOX=true

# Limites
API_RATE_LIMIT_PER_MINUTE=300

# Backup (docker compose --profile backup up -d backup)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24
