# Modelo para o servidor (testes e produção): cp .env.example .env NO SERVIDOR e preencha.
# Para desenvolvimento local, use o .env.example.local.
# Lê só o docker-compose.yml: o override (Postgres local, Mailpit, portas de debug) fica de fora.
COMPOSE_FILE=docker-compose.yml

# App
ASPNETCORE_ENVIRONMENT=Staging
APP_PORT=7700
# URL pública, usada nos links dos e-mails. Precisa ser HTTPS: fora de Development os cookies são Secure.
PUBLIC_BASE_URL=https://contratos-teste.exemplo.com.br
# A app fica atrás de um proxy com TLS (Caddy, Nginx, load balancer)
FORWARDED_HEADERS=true
# Aplica as migrations na subida (prático em testes; em produção prefira o bundle antes do deploy)
MIGRATE_ON_STARTUP=true

# Banco externo
DB_HOST=
DB_PORT=5432
DB_NAME=contratos
DB_USER=contratos
DB_PASSWORD=
# require: banco gerenciado com TLS. disable: banco na mesma rede Docker/privada sem SSL
# (ex.: Postgres criado pelo Coolify) - com require ele falha com "No SSL enabled connection".
DB_SSL_MODE=require

# Storage S3. Com o serviço "s3" do compose (SeaweedFS) deixe como está.
# Oracle Cloud (OCI): S3_SERVICE_URL=https://<namespace>.compat.objectstorage.<região>.oraclecloud.com,
# S3_REGION=<região> (ex.: ca-toronto-1), chaves de "Customer secret keys" e S3_CREATE_BUCKET=false.
S3_SERVICE_URL=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=contratos
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_CREATE_BUCKET=true

# E-mails do sistema (confirmação de cadastro, convites, nova senha) pela Resend.
# EMAIL_FROM precisa ser de um domínio verificado na Resend (resend.com/domains).
EMAIL_PROVIDER=Resend
EMAIL_FROM=nao-responda@exemplo.com.br
EMAIL_FROM_NAME=Contratos
RESEND_API_KEY=
# Alternativa: EMAIL_PROVIDER=Smtp e as variáveis abaixo.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=StartTls
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Assinatura: Autentique (Fake = simulador, sem assinatura real). Veja docs/operacao.md, "Assinatura (Autentique)".
SIGNATURE_PROVIDER=Autentique
AUTENTIQUE_API_KEY=
# Um secret por endpoint de webhook do painel (documentos e assinaturas são endpoints separados), separados por vírgula.
AUTENTIQUE_WEBHOOK_SECRET=
# true: documentos de teste, sem gastar créditos (somem depois de alguns dias). Em produção, false.
AUTENTIQUE_SANDBOX=true
# Alerta de saldo baixo na conta da plataforma (e-mail da equipe, não de clientes) e o limite em documentos.
AUTENTIQUE_ALERT_EMAIL=
AUTENTIQUE_LOW_DOCUMENTS=20

# Planos e créditos. Veja docs/operacao.md, "Planos e créditos".
# Plano de quem cria conta: avulso (só créditos, com 3 contratos de boas-vindas), essencial, profissional ou empresa.
BILLING_DEFAULT_PLAN=avulso
# Contato mostrado em Configurações para mudar de plano ou comprar contratos (enquanto não há checkout).
BILLING_CONTACT_EMAIL=
# Chave da API da plataforma (trocar plano, conceder créditos). Vazio desliga a API. Gere com: openssl rand -hex 32
PLATFORM_API_KEY=
# Portal super admin (/superadmin/): contas próprias, criadas pela linha de comando (docs/operacao.md).

# API pública (plano Empresa): limite por chave. Webhooks só para endereços públicos com https.
# Veja docs/operacao.md, "API pública e webhooks".
PUBLIC_API_PERMITS_PER_MINUTE=120
WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false

# Assinatura online pelo Stripe (só cartão). Vazio: sem botão de assinar, só o contato acima.
# Veja docs/operacao.md, "Assinatura online (Stripe)". Teste: sk_test_...; produção: sk_live_...
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) do endpoint https://SEU_DOMINIO/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Limites
API_RATE_LIMIT_PER_MINUTE=300

# Backup (docker compose --profile backup up -d backup)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24
