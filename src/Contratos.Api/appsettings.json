{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "App": {
    "ProductName": "Contratos",
    "PublicBaseUrl": "http://localhost:7700"
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "nao-responda@contratos.local",
    "FromName": "Contratos"
  },
  "Smtp": {
    "Port": 587,
    "Security": "StartTls"
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
