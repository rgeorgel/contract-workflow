# Modelo para desenvolvimento local: cp .env.example.local .env
# Usa docker-compose.yml + docker-compose.override.yml (Postgres local, Mailpit, portas de debug).
# O modelo do servidor é o .env.example.

# Banco. Em dev o Postgres sobe pelo docker-compose.override.yml (DB_HOST=db).
# Quando só o docker-compose.yml é usado (servidor), aponte para o banco externo.
DB_HOST=db
DB_PORT=5432
DB_NAME=contratos
DB_USER=contratos
DB_PASSWORD=contratos
# prefer | require | disable (require para banco gerenciado na nuvem)
DB_SSL_MODE=prefer
# Porta do Postgres local publicada na sua máquina (só dev, override)
DB_PUBLISHED_PORT=5434

# Arquivos que o Compose lê. Vazio = docker-compose.yml + docker-compose.override.yml.
# COMPOSE_FILE=docker-compose.yml

# App
APP_PORT=7700
PUBLIC_BASE_URL=http://localhost:7700

# Storage S3-compatível (SeaweedFS no Compose; AWS S3, R2, Wasabi ou Spaces em produção)
S3_SERVICE_URL=http://s3:8333
S3_BUCKET=contratos
S3_ACCESS_KEY=contratos
S3_SECRET_KEY=contratos-s3-secret
S3_PORT=8333
GOTENBERG_PORT=3005

# Assinatura: Fake até a fase 4
SIGNATURE_PROVIDER=Fake
AUTENTIQUE_API_KEY=
AUTENTIQUE_WEBHOOK_SECRET=
AUTENTIQUE_SANDBOX=true

# E-mails do sistema (em dev, o override usa o Mailpit e ignora estes)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@contratos.local

# Mailpit (só dev)
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026

# Proxy reverso com TLS na frente da app (Caddy, Nginx, load balancer)
FORWARDED_HEADERS=false
API_RATE_LIMIT_PER_MINUTE=300

# Backup do banco (docker compose --profile backup up -d backup)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24
